---
/**
 * IconClose - X close icon
 */
interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 28 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  aria-hidden="true"
>
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    d="M6 18L18 6M6 6l12 12"
  />
</svg>
