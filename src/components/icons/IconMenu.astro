---
/**
 * IconMenu - Hamburger menu icon (3 horizontal lines)
 */
interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 28 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  aria-hidden="true"
>
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    d="M4 6h16M4 12h16M4 18h16"
  />
</svg>
