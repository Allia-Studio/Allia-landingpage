---
/**
 * ServiceItem.astro - Item individual de servicio con hover expand
 * Layout: título+descripción (izq) | tags (centro) | número (der)
 */
import type { Service } from '../../lib/types';
import ServiceTag from './ServiceTag.astro';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article
  class="service-item group border-t border-white/10 py-10 md:py-14 px-4 md:px-8 cursor-default"
  data-service-id={service.id}
  data-index={index}
>
  <div class="grid grid-cols-1 md:grid-cols-[1fr_280px_60px] gap-6 md:gap-8 items-start">
    <!-- Columna izquierda: Título + Descripción -->
    <div class="space-y-2">
      <h3 class="font-title text-2xl md:text-3xl lg:text-4xl text-white font-normal">
        {service.title}
      </h3>
      <p class="text-[--color-gray] text-base md:text-lg">
        {service.description}
      </p>

      <!-- Detalles expandidos (visible en hover) -->
      {service.expandedDetails && (
        <p class="expanded-details text-white/70 text-sm md:text-base max-h-0 overflow-hidden opacity-0">
          {service.expandedDetails}
        </p>
      )}
    </div>

    <!-- Columna centro: Tags en grid 2 columnas con ancho fijo -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-2 md:gap-y-3 content-start">
      {service.tags.map((tag) => (
        <ServiceTag label={tag.label} />
      ))}
    </div>

    <!-- Columna derecha: Número -->
    <span class="service-number hidden md:block font-title text-4xl lg:text-5xl text-[--color-accent]/40 tabular-nums text-right">
      {number}
    </span>
  </div>
</article>

<style>
  .service-item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      background-color var(--transition-normal),
      opacity 0.6s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
  }

  .service-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .service-item:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .service-number {
    transition: color var(--transition-normal);
  }

  .service-item:hover .service-number {
    color: var(--color-accent);
  }

  .expanded-details {
    transition:
      max-height 0.4s var(--ease-out-expo),
      opacity 0.4s var(--ease-out-expo),
      margin-top 0.4s var(--ease-out-expo);
  }

  .service-item:hover .expanded-details {
    max-height: 100px;
    opacity: 1;
    margin-top: 0.75rem;
  }
</style>
