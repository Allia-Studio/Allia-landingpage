---
import { NAV_LINKS } from '../../lib/constants';
---

<nav
  id="navbar"
  class="fixed top-0 left-0 w-full z-[var(--z-navbar)] pt-[var(--spacing-nav-top)] px-[var(--spacing-container)]"
  aria-label="Navegación principal"
>
  <!-- Contenedor interno - se convierte en barra unificada al hacer scroll -->
  <div class="navbar-inner w-full max-w-[var(--container-max-width)] mx-auto flex justify-between items-center">

    <!-- Logo -->
    <a href="/" class="flex items-center" aria-label="Allia Studio - Ir al inicio">
      <img src="/logo-white.png" alt="Allia Studio" class="logo-white h-5 w-auto" />
      <img src="/logo-dark.png" alt="Allia Studio" class="logo-dark h-5 w-auto" />
    </a>

    <!-- Links de navegación -->
    <div class="flex items-center gap-[var(--spacing-nav-gap)]">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="nav-link font-display text-lg text-[--color-white] uppercase tracking-wide link-underline"
        >
          {link.label}
        </a>
      ))}
    </div>

  </div>
</nav>

<style>
  /* Transición unificada solo en navbar-inner */
  .navbar-inner {
    padding: 12px 16px;
    background-color: transparent;
    transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Transición de color en links */
  .nav-link {
    transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link::after {
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Estado scrolled - barra unificada */
  #navbar.scrolled .navbar-inner {
    background-color: var(--color-white);
  }

  /* Cambio de color del texto al hacer scroll */
  #navbar.scrolled .nav-link {
    color: var(--color-bg);
  }

  #navbar.scrolled .nav-link::after {
    background-color: var(--color-bg);
  }

  /* Intercambio de logo - estado por defecto (logo blanco visible) */
  .logo-white {
    display: block;
  }

  .logo-dark {
    display: none;
  }

  /* Intercambio de logo al hacer scroll (logo oscuro visible) */
  #navbar.scrolled .logo-white {
    display: none;
  }

  #navbar.scrolled .logo-dark {
    display: block;
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const SCROLL_THRESHOLD = 80;

  if (navbar) {
    const controller = new AbortController();
    const { signal } = controller;

    let ticking = false;
    const handleScroll = (): void => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          if (scrollY > SCROLL_THRESHOLD) {
            navbar.classList.add('scrolled');
          } else {
            navbar.classList.remove('scrolled');
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { signal, passive: true });
    handleScroll();

    // Limpieza en View Transitions
    document.addEventListener('astro:before-swap', () => {
      controller.abort();
    }, { once: true });
  }
</script>
