---
import { NAV_LINKS, ELEMENT_IDS } from '../../lib/constants';
---

<nav
  id="navbar"
  class="fixed top-0 left-0 w-full z-[var(--z-navbar)] pt-[var(--spacing-nav-top)] px-[var(--spacing-container)]"
  aria-label="Navegación principal"
>
  <!-- Contenedor interno - se convierte en barra unificada al hacer scroll -->
  <div class="navbar-inner w-full max-w-[var(--container-max-width)] mx-auto flex justify-between items-center">

    <!-- Logo -->
    <a href="/" class="flex items-center" aria-label="Allia Studio - Ir al inicio">
      <img src="/logo-white.png" alt="Allia Studio" class="logo-white h-5 w-auto" />
      <img src="/logo-dark.png" alt="Allia Studio" class="logo-dark h-5 w-auto" />
    </a>

    <!-- Links de navegación (Desktop) -->
    <div class="hidden md:flex items-center gap-[var(--spacing-nav-gap)]">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="nav-link font-display text-lg text-[--color-white] uppercase tracking-wide link-underline"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Hamburger Button (Mobile) -->
    <button
      id={ELEMENT_IDS.menuToggle}
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 relative z-10 focus-ring"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls={ELEMENT_IDS.mobileMenu}
    >
      <span class="hamburger-line hamburger-line-1"></span>
      <span class="hamburger-line hamburger-line-2"></span>
      <span class="hamburger-line hamburger-line-3"></span>
    </button>

  </div>
</nav>

<!-- Mobile Menu Panel -->
<div
  id={ELEMENT_IDS.mobileMenu}
  class="mobile-menu fixed inset-0 z-[calc(var(--z-navbar)-1)] md:hidden"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div class="mobile-menu-backdrop absolute inset-0 bg-(--color-black)/90"></div>
  
  <!-- Menu Content -->
  <div class="mobile-menu-content relative h-full flex flex-col justify-center items-center gap-8 px-[var(--spacing-container)]">
    {NAV_LINKS.map((link, index) => (
      <a
        href={link.href}
        class="mobile-nav-link font-display text-3xl md:text-4xl text-(--color-white) uppercase tracking-wide hover:text-(--color-accent) transition-colors"
        style={`--delay: ${index * 50}ms`}
      >
        {link.label}
      </a>
    ))}
  </div>
</div>

<style>
  /* ===========================================
     Navbar Base & Scrolled States
     =========================================== */
  .navbar-inner {
    padding: 12px 16px;
    background-color: transparent;
    transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link {
    transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link::after {
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Estado scrolled - barra unificada */
  #navbar.scrolled .navbar-inner {
    background-color: var(--color-white);
  }

  #navbar.scrolled .nav-link {
    color: var(--color-bg);
  }

  #navbar.scrolled .nav-link::after {
    background-color: var(--color-bg);
  }

  /* ===========================================
     Logo Swap
     =========================================== */
  .logo-white {
    display: block;
  }

  .logo-dark {
    display: none;
  }

  #navbar.scrolled .logo-white {
    display: none;
  }

  #navbar.scrolled .logo-dark {
    display: block;
  }

  /* ===========================================
     Hamburger Button
     =========================================== */
  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-white);
    transition: transform 0.3s var(--ease-out-expo),
                opacity 0.3s var(--ease-out-expo),
                background-color 0.4s var(--ease-out-expo);
  }

  .hamburger-line-1 {
    transform: translateY(-6px);
  }

  .hamburger-line-2 {
    transform: translateY(0);
  }

  .hamburger-line-3 {
    transform: translateY(6px);
  }

  /* Hamburger color on scrolled */
  #navbar.scrolled .hamburger-line {
    background-color: var(--color-bg);
  }

  /* Hamburger X state when menu open */
  #navbar.menu-open .hamburger-line {
    background-color: var(--color-white);
  }

  #navbar.menu-open .hamburger-line-1 {
    transform: translateY(0) rotate(45deg);
  }

  #navbar.menu-open .hamburger-line-2 {
    opacity: 0;
  }

  #navbar.menu-open .hamburger-line-3 {
    transform: translateY(0) rotate(-45deg);
  }

  /* ===========================================
     Mobile Menu
     =========================================== */
  .mobile-menu {
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu-backdrop {
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .mobile-menu-content {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s var(--ease-out-expo),
                transform 0.4s var(--ease-out-expo);
  }

  .mobile-nav-link {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s var(--ease-out-expo),
                transform 0.4s var(--ease-out-expo),
                color 0.25s ease;
    transition-delay: var(--delay, 0ms);
  }

  /* Menu Open State */
  .mobile-menu.open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-menu.open .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu.open .mobile-menu-content {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu.open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===========================================
     Focus States
     =========================================== */
  .focus-ring:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileNavLinks = mobileMenu?.querySelectorAll('.mobile-nav-link');
  const SCROLL_THRESHOLD = 80;

  let isMenuOpen = false;

  /**
   * Toggle mobile menu open/close state
   */
  function toggleMenu(): void {
    isMenuOpen = !isMenuOpen;
    
    if (isMenuOpen) {
      openMenu();
    } else {
      closeMenu();
    }
  }

  /**
   * Open mobile menu
   */
  function openMenu(): void {
    isMenuOpen = true;
    navbar?.classList.add('menu-open');
    mobileMenu?.classList.add('open');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', 'Cerrar menú de navegación');
    document.body.style.overflow = 'hidden';
    
    // Focus first link
    const firstLink = mobileNavLinks?.[0] as HTMLElement;
    setTimeout(() => firstLink?.focus(), 100);
  }

  /**
   * Close mobile menu
   */
  function closeMenu(): void {
    isMenuOpen = false;
    navbar?.classList.remove('menu-open');
    mobileMenu?.classList.remove('open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú de navegación');
    document.body.style.overflow = '';
  }

  /**
   * Handle scroll for navbar background
   */
  function handleScroll(): void {
    const scrollY = window.scrollY;
    if (scrollY > SCROLL_THRESHOLD) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  }

  /**
   * Handle keyboard events
   */
  function handleKeydown(event: KeyboardEvent): void {
    if (event.key === 'Escape' && isMenuOpen) {
      closeMenu();
      menuToggle?.focus();
    }
  }

  // Event Listeners
  if (navbar && menuToggle && mobileMenu) {
    const controller = new AbortController();
    const { signal } = controller;

    // Hamburger click
    menuToggle.addEventListener('click', toggleMenu, { signal });

    // Close on nav link click
    mobileNavLinks?.forEach(link => {
      link.addEventListener('click', closeMenu, { signal });
    });

    // Close on backdrop click
    mobileMenu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).classList.contains('mobile-menu-backdrop')) {
        closeMenu();
      }
    }, { signal });

    // Escape key
    document.addEventListener('keydown', handleKeydown, { signal });

    // Scroll handling with rAF
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { signal, passive: true });

    // Initial scroll check
    handleScroll();

    // Cleanup on View Transitions
    document.addEventListener('astro:before-swap', () => {
      closeMenu();
      controller.abort();
    }, { once: true });
  }
</script>
