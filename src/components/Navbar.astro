---
interface NavLink {
  label: string;
  href: string;
}

const navLinks: NavLink[] = [
  { label: 'SERVICIOS.', href: '#servicios' },
  { label: 'NOSOTROS.', href: '#nosotros' },
  { label: 'PROYECTOS.', href: '#proyectos' },
  { label: 'SOLUCIONES.', href: '#soluciones' },
];
---

<nav
  class="fixed top-0 left-0 w-full z-[var(--z-navbar)] pt-9 px-6 md:px-12 h-20 flex items-start"
  aria-label="Navegación principal"
>
  <div class="w-full max-w-[1800px] mx-auto flex justify-between items-center">
    <a href="/" class="flex items-center" aria-label="Allia Studio - Ir al inicio">
      <img
        src="/allia-logo-blanco.svg"
        alt=""
        aria-hidden="true"
        class="h-12 w-auto"
        width="180"
        height="48"
      />
    </a>

    <!-- Desktop menu -->
    <div class="hidden md:flex items-center gap-16">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-display text-xl text-white uppercase tracking-wide link-underline"
        >
          {link.label}
        </a>
      ))}
      <button
        class="font-display text-[1.75rem] text-white leading-none relative -top-1 transition-transform duration-200 hover:scale-110"
        aria-label="Menú adicional"
      >
        +
      </button>
    </div>

    <!-- Mobile menu button -->
    <button
      class="md:hidden text-white p-2 z-[var(--z-navbar-toggle)]"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="menu-toggle"
    >
      <svg class="w-8 h-8 hamburger-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="w-8 h-8 close-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-[--color-bg]/95 backdrop-blur-sm flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
    aria-hidden="true"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="font-display text-3xl text-white uppercase tracking-wide mobile-nav-link"
        tabindex="-1"
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = toggle?.querySelector('.hamburger-icon');
  const closeIcon = toggle?.querySelector('.close-icon');
  const mobileLinks = menu?.querySelectorAll('.mobile-nav-link');

  if (toggle && menu && hamburgerIcon && closeIcon) {
    const closeMenu = (): void => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      menu.setAttribute('aria-hidden', 'true');
      menu.classList.add('opacity-0', 'pointer-events-none');
      menu.classList.remove('opacity-100', 'pointer-events-auto');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      document.body.style.overflow = '';

      // Remove tabindex from links
      mobileLinks?.forEach(link => link.setAttribute('tabindex', '-1'));
    };

    const openMenu = (): void => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú de navegación');
      menu.setAttribute('aria-hidden', 'false');
      menu.classList.remove('opacity-0', 'pointer-events-none');
      menu.classList.add('opacity-100', 'pointer-events-auto');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // Enable tabindex for links
      mobileLinks?.forEach(link => link.setAttribute('tabindex', '0'));

      // Focus first link
      (mobileLinks?.[0] as HTMLElement)?.focus();
    };

    // Toggle menu on button click
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    // Close with Escape key
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });

    // Close when clicking a link
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on resize to desktop
    const mediaQuery = window.matchMedia('(min-width: 768px)');
    mediaQuery.addEventListener('change', (e: MediaQueryListEvent) => {
      if (e.matches) closeMenu();
    });
  }
</script>
