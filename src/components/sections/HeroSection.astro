---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { HERO, ANIMATION, CALCOM, ELEMENT_IDS } from '../../lib/constants';
---

<Section fullHeight padded={false} class="pt-20 overflow-hidden">
  <Container class="relative z-10">
    <h1 class="hero-title font-title font-normal leading-[1.02] mb-[var(--spacing-hero-title-bottom)] text-[--color-white] tracking-tight">
      <!-- Contenido de respaldo para no-JS / SEO -->
      <noscript>
        <span class="block">{HERO.lines[0].text}</span>
        <span class="block">{HERO.lines[1].text}</span>
      </noscript>
      <!-- Contenido animado -->
      <span class="block min-h-[1.1em]" id={ELEMENT_IDS.heroTitleLine1} aria-label={HERO.lines[0].text}></span>
      <span class="block min-h-[1.1em]" id={ELEMENT_IDS.heroTitleLine2} aria-label={HERO.lines[1].text}></span>
    </h1>

    <p
      class="text-lg md:text-xl lg:text-2xl font-normal text-(--color-white) mb-[var(--spacing-hero-subtitle-bottom)] leading-relaxed opacity-0 transition-all duration-700"
      id={ELEMENT_IDS.heroSubtitle}
    >
      {HERO.subtitle}
    </p>

    <div class="flex flex-wrap gap-4 items-center opacity-0 translate-y-4" id={ELEMENT_IDS.heroCta}>
      <Button
        href="#"
        variant="primary"
        size="md"
        data-cal-link={CALCOM.link}
        data-cal-namespace={CALCOM.namespace}
        data-cal-config={JSON.stringify(CALCOM.config)}
      >
        {HERO.ctaPrimary}
      </Button>
      <Button
        href="#proyectos"
        variant="ghost"
        size="md"
      >
        {HERO.ctaSecondary}
      </Button>
    </div>
  </Container>
</Section>

<script define:vars={{ ANIMATION, HERO, ELEMENT_IDS }}>
  // Animación typewriter usando constantes centralizadas
  const lines = HERO.lines;
  const typeSpeed = ANIMATION.typeSpeed;
  const cursorChar = HERO.cursorChar;

  // Flag de cancelación para View Transitions
  let animationAborted = false;

  /**
   * Crea una promesa de delay cancelable
   * @param {number} ms - Milisegundos a esperar
   * @returns {Promise<boolean>} - Resuelve a true si completó, false si se abortó
   */
  function delay(ms) {
    return new Promise(resolve => {
      let checkAbort;
      const timeoutId = setTimeout(() => {
        clearInterval(checkAbort);
        resolve(true);
      }, ms);
      // Verifica periódicamente si la animación fue abortada
      checkAbort = setInterval(() => {
        if (animationAborted) {
          clearTimeout(timeoutId);
          clearInterval(checkAbort);
          resolve(false);
        }
      }, 50);
    });
  }

  /**
   * Escribe texto caracter por caracter con cursor parpadeante
   * @param {string} elementId - ID del elemento objetivo
   * @param {string} text - Texto a escribir
   */
  async function typeText(elementId, text) {
    const element = document.getElementById(elementId);
    if (!element) {
      console.warn(`[HeroSection] Elemento no encontrado: ${elementId}`);
      return;
    }

    element.textContent = cursorChar;

    for (let i = 0; i <= text.length; i++) {
      if (animationAborted) return;
      await delay(typeSpeed);
      if (animationAborted) return;
      element.textContent = text.slice(0, i) + cursorChar;
    }

    // Quita el cursor después de escribir
    if (animationAborted) return;
    await delay(ANIMATION.cursorRemoveDelay);
    if (!animationAborted) {
      element.textContent = text;
    }
  }

  /**
   * Muestra contenido estático inmediatamente (fallback para animación abortada)
   */
  function showStaticContent() {
    lines.forEach(line => {
      const element = document.getElementById(line.element);
      if (element) element.textContent = line.text;
    });

    const subtitle = document.getElementById(ELEMENT_IDS.heroSubtitle);
    const cta = document.getElementById(ELEMENT_IDS.heroCta);

    if (subtitle) {
      subtitle.classList.remove('opacity-0');
      subtitle.classList.add('opacity-100');
    }
    if (cta) {
      cta.classList.remove('opacity-0', 'translate-y-4');
      cta.classList.add('opacity-100', 'translate-y-0');
    }
  }

  /**
   * Ejecuta la secuencia de animación typewriter
   */
  async function runTypewriter() {
    try {
      for (const line of lines) {
        if (animationAborted) return showStaticContent();
        const completed = await delay(line.delay);
        if (!completed || animationAborted) return showStaticContent();
        await typeText(line.element, line.text);
      }

      if (animationAborted) return showStaticContent();

      // Fade in del subtítulo y CTA juntos después de escribir
      const subtitle = document.getElementById(ELEMENT_IDS.heroSubtitle);
      const cta = document.getElementById(ELEMENT_IDS.heroCta);

      await delay(ANIMATION.postTypingDelay);

      // Muestra ambos al mismo tiempo
      if (subtitle) {
        subtitle.classList.remove('opacity-0');
        subtitle.classList.add('opacity-100');
      }

      if (cta) {
        cta.classList.remove('opacity-0', 'translate-y-4');
        cta.classList.add('opacity-100', 'translate-y-0');
      }
    } catch (error) {
      console.error('[HeroSection] Error de animación:', error);
      showStaticContent();
    }
  }

  // Limpieza en navegación con View Transitions
  document.addEventListener('astro:before-swap', () => {
    animationAborted = true;
  }, { once: true });

  // Inicia la animación cuando el DOM está listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runTypewriter);
  } else {
    runTypewriter();
  }
</script>

<style>
  /* Tamaño del título hero */
  .hero-title {
    font-size: var(--text-hero);
    text-decoration: none;
  }

  .hero-title span {
    text-decoration: none;
  }

  /* Transición de aparición del botón CTA */
  #hero-cta {
    transition: opacity var(--transition-slow), transform var(--transition-slow);
  }
</style>
