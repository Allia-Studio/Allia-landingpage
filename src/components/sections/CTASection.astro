---
/**
 * CTASection.astro - Call to action final
 * Centrado, fondo default, Cal.com integration
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { SECTION_HEADERS, CALCOM } from '../../lib/constants';
---

<Section id="cta" background="default" class="text-center">
  <Container class="max-w-3xl mx-auto">
    <h2 class="font-title text-6xl uppercase leading-tight mb-6">
      {SECTION_HEADERS.cta.title}
    </h2>

    <p class="text-xl text-[--color-gray] leading-relaxed mb-10 max-w-2xl mx-auto">
      {SECTION_HEADERS.cta.subtitle}
    </p>

    <Button
      href="#"
      variant="primary"
      size="lg"
      data-cal-link={CALCOM.link}
      data-cal-namespace={CALCOM.namespace}
      data-cal-config={JSON.stringify(CALCOM.config)}
    >
      Agendar Reunión
    </Button>

    <p class="mt-6 text-sm text-[--color-gray]">
      30 minutos. Sin compromiso. Sin presión.
    </p>
  </Container>
</Section>
