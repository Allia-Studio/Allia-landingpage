---
/**
 * FAQSection.astro - Preguntas frecuentes
 * 2 columnas de accordions
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Accordion from '../ui/Accordion.astro';
import { SECTION_HEADERS, FAQS } from '../../lib/constants';

// Split FAQs into two columns
const midpoint = Math.ceil(FAQS.length / 2);
const leftColumnFaqs = FAQS.slice(0, midpoint);
const rightColumnFaqs = FAQS.slice(midpoint);
---

<Section id="faq" background="dark">
  <Container>
    <SectionHeader {...SECTION_HEADERS.faq} centered />

    <div class="grid grid-cols-2 gap-12 max-w-5xl mx-auto">
      <!-- Left Column -->
      <div class="space-y-0">
        {leftColumnFaqs.map((faq) => (
          <Accordion item={faq} />
        ))}
      </div>

      <!-- Right Column -->
      <div class="space-y-0">
        {rightColumnFaqs.map((faq) => (
          <Accordion item={faq} />
        ))}
      </div>
    </div>
  </Container>
</Section>
