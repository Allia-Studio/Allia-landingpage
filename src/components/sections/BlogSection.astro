---
/**
 * BlogSection.astro - Sección de blog/insights
 * Layout asimétrico: 1 post featured + 2 posts compactos
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import IconArrowRight from '../icons/IconArrowRight.astro';
import { SECTION_HEADERS, BLOG_POSTS } from '../../lib/constants';

const featuredPost = BLOG_POSTS.find((post) => post.featured);
const otherPosts = BLOG_POSTS.filter((post) => !post.featured);
---

<Section id="blog" background="default">
  <Container>
    <SectionHeader {...SECTION_HEADERS.blog} />

    <div class="grid grid-cols-2 gap-8">
      <!-- Featured Post -->
      {featuredPost && (
        <article class="group relative overflow-hidden rounded-[--radius-lg] bg-[--color-surface] border border-[--color-border] hover:border-[--color-accent] transition-colors row-span-2">
          <!-- Image placeholder -->
          <div class="aspect-[16/9] bg-gradient-to-br from-[--color-accent]/20 to-[--color-bg-dark]" />

          <div class="p-8">
            <div class="flex items-center gap-3 mb-4">
              <Tag label={featuredPost.category} variant="solid" size="sm" />
              <span class="text-xs text-[--color-gray]">{featuredPost.readTime}</span>
            </div>

            <h3 class="font-title text-3xl uppercase mb-4 group-hover:text-[--color-accent] transition-colors">
              {featuredPost.title}
            </h3>

            <p class="text-[--color-gray] leading-relaxed mb-6">
              {featuredPost.excerpt}
            </p>

            <a
              href={`/blog/${featuredPost.slug}`}
              class="inline-flex items-center gap-2 text-[--color-accent] hover:gap-3 transition-all"
            >
              Leer más
              <IconArrowRight size={16} />
            </a>
          </div>
        </article>
      )}

      <!-- Other Posts -->
      <div class="flex flex-col gap-6">
        {otherPosts.map((post) => (
          <article class="group flex gap-4 p-4 rounded-[--radius-md] bg-[--color-surface] border border-[--color-border] hover:border-[--color-accent] transition-colors">
            <!-- Image placeholder -->
            <div class="w-24 h-24 flex-shrink-0 rounded-[--radius-sm] bg-gradient-to-br from-[--color-accent]/20 to-[--color-bg-dark]" />

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2">
                <Tag label={post.category} variant="ghost" size="sm" />
                <span class="text-xs text-[--color-gray]">{post.readTime}</span>
              </div>

              <h3 class="font-medium text-[--color-white] group-hover:text-[--color-accent] transition-colors line-clamp-2 mb-2">
                {post.title}
              </h3>

              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-1 text-sm text-[--color-gray] hover:text-[--color-accent] transition-colors"
              >
                Leer más
                <IconArrowRight size={14} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Container>
</Section>
