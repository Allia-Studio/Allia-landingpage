---
/**
 * FooterSection.astro - Footer con columnas de links y socials
 */
import Container from '../ui/Container.astro';
import FooterColumn from '../ui/FooterColumn.astro';
import IconLinkedin from '../icons/IconLinkedin.astro';
import IconGithub from '../icons/IconGithub.astro';
import IconTwitter from '../icons/IconTwitter.astro';
import { SITE, FOOTER_COLUMNS, SOCIAL_LINKS, FOOTER_INFO } from '../../lib/constants';

const socialIcons = {
  linkedin: IconLinkedin,
  github: IconGithub,
  twitter: IconTwitter,
};
---

<footer class="bg-[--color-bg-dark] border-t border-[--color-border]">
  <Container class="py-20">
    <div class="grid grid-cols-5 gap-8">
      <!-- Brand Column -->
      <div class="col-span-2">
        <a href="/" class="inline-block mb-4">
          <span class="font-display text-2xl text-[--color-white]">{SITE.name}</span>
        </a>
        <p class="text-[--color-gray] mb-6 max-w-xs">
          {FOOTER_INFO.tagline}
        </p>

        <!-- Social Links -->
        <div class="flex gap-4">
          {SOCIAL_LINKS.map((social) => {
            const IconComponent = socialIcons[social.icon];
            return (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="p-2 rounded-full border border-[--color-border] text-[--color-gray] hover:border-[--color-accent] hover:text-[--color-accent] transition-colors"
              >
                <IconComponent size={20} />
              </a>
            );
          })}
        </div>
      </div>

      <!-- Link Columns -->
      {FOOTER_COLUMNS.map((column) => (
        <FooterColumn column={column} />
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-[--color-border] flex justify-between items-center gap-4">
      <p class="text-sm text-[--color-gray]">
        {FOOTER_INFO.copyright}
      </p>
      <p class="text-sm text-[--color-gray]">
        Hecho con <span class="text-[--color-accent]">cuidado</span> en Latinoamérica
      </p>
    </div>
  </Container>
</footer>
