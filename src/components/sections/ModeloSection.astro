---
/**
 * ModeloSection.astro - Sección "DOS CAMINOS, UNA META"
 * Diseño side-by-side para presentar los dos modelos de trabajo
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { MODELO_SECTION, MODELOS, CALCOM } from '../../lib/constants';
---

<Section id={MODELO_SECTION.sectionId} background="light" padded aria-labelledby="modelo-title">
  <Container>
    <header class="mb-16 md:mb-20">
      <span class="inline-block text-sm md:text-base text-(--color-accent-hover) tracking-[0.25em] uppercase mb-4 font-medium">
        {MODELO_SECTION.label}
      </span>
      <h2
        id="modelo-title"
        class="font-title text-[length:var(--text-section-title)] text-(--color-bg) leading-[1.02] mb-6"
      >
        {MODELO_SECTION.title}
      </h2>
      <p class="text-lg md:text-xl lg:text-2xl text-(--color-gray-dark) leading-relaxed">
        {MODELO_SECTION.subtitle}
      </p>
    </header>

    <!-- Cards lado a lado -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 mb-12 md:mb-16">
      {MODELOS.map((modelo) => (
        <article class="modelo-card flex flex-col p-6 md:p-8 border border-(--color-gray-light) bg-(--color-white)">
          <h3 class="font-title text-2xl md:text-3xl text-(--color-bg) mb-5">
            {modelo.title}
          </h3>
          <p class="text-base md:text-lg text-(--color-gray-dark) leading-relaxed">
            {modelo.description}
          </p>
          <div class="mt-auto pt-6">
            <span class="block h-px bg-(--color-gray-light) mb-5"></span>
            <p class="flex items-start gap-2 text-base md:text-lg text-(--color-accent) font-medium mb-2">
              <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <span>Ideal para</span>
            </p>
            <p class="text-base md:text-lg text-(--color-gray-dark) leading-relaxed">
              {modelo.idealFor}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA unificado -->
    <div class="text-center">
      <p class="text-lg md:text-xl text-(--color-gray-dark) mb-6">
        ¿No sabes cuál es para ti?
      </p>
      <button
        class="btn-dark inline-flex items-center justify-center px-7 py-4 text-xl font-display font-normal uppercase tracking-wide cursor-pointer relative overflow-hidden border-2 border-(--color-bg)"
        data-cal-link={CALCOM.link}
        data-cal-namespace={CALCOM.namespace}
        data-cal-config={JSON.stringify(CALCOM.config)}
      >
        <span class="btn-text relative z-10">{MODELO_SECTION.ctaGeneral}</span>
        <span class="btn-bg"></span>
      </button>
    </div>
  </Container>
</Section>

<style>
  /* Botón estilo hero pero para fondo claro */
  .btn-dark {
    color: var(--color-white);
    background: transparent;
  }

  .btn-dark .btn-bg {
    position: absolute;
    inset: 0;
    background-color: var(--color-bg);
    z-index: 0;
  }

  .btn-dark::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform: translateX(-100%);
    transition: transform 0.4s var(--ease-out-expo);
    z-index: 1;
  }

  .btn-dark:hover {
    color: var(--color-bg);
  }

  .btn-dark:hover::before {
    transform: translateX(0);
  }

  .btn-dark .btn-text {
    z-index: 2;
  }

  .btn-dark:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
