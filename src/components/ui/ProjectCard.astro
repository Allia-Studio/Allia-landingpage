---
/**
 * ProjectCard.astro - Tarjeta de proyecto
 * Imagen en escala de grises, al hover muestra color + info overlay
 * Touch devices: tap-to-reveal behavior (via shared script)
 */
import type { Project } from '../../lib/types';

interface Props extends Project {}

const { name, description, image, url, size } = Astro.props;

const hasLink = Boolean(url);

// Aspect ratios según el tamaño en el grid
const aspectClasses = {
  normal: 'aspect-square',
  tall: 'aspect-square',
  wide: 'aspect-square md:aspect-[2/1]',
};
---

<article 
  class:list={[
    "project-card group relative overflow-hidden rounded-lg cursor-pointer",
    aspectClasses[size]
  ]}
  data-card-reveal
>
  <!-- Imagen con filtro grayscale -->
  <img
    src={image}
    alt={`Proyecto ${name}`}
    class="w-full h-full object-cover transition-all duration-500 grayscale group-hover:grayscale-0 group-[.active]:grayscale-0"
    loading="lazy"
  />

  <!-- Overlay con gradiente -->
  <div class="card-overlay absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity duration-500" />

  <!-- Info container (aparece desde abajo) -->
  <div class="card-info absolute bottom-0 left-0 right-0 p-5 md:p-6 translate-y-full group-hover:translate-y-0 group-[.active]:translate-y-0 transition-transform duration-500 ease-out">
    <!-- Header: Título + Botón -->
    <div class="flex items-center justify-between mb-3">
      <h4 class="font-title text-xl md:text-2xl text-(--color-white)">
        {name}
      </h4>
      {hasLink ? (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="card-action flex-shrink-0 w-9 h-9 md:w-10 md:h-10 flex items-center justify-center rounded-full bg-(--color-white)/10 text-(--color-white) hover:bg-(--color-accent) hover:text-(--color-white) transition-colors"
          aria-label={`Ver proyecto ${name}`}
        >
          <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ) : (
        <span
          class="flex-shrink-0 w-9 h-9 md:w-10 md:h-10 flex items-center justify-center rounded-full bg-(--color-white)/5 text-(--color-gray-dark) cursor-not-allowed"
          aria-label="Link no disponible"
          title="Próximamente"
        >
          <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </span>
      )}
    </div>

    <!-- Separador -->
    <div class="h-px bg-(--color-white)/20 mb-3"></div>

    <!-- Descripción -->
    <p class="text-sm md:text-base text-(--color-gray-light) leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>
</article>
