---
/**
 * ProjectCard.astro - Tarjeta de proyecto
 * Imagen en escala de grises, al hover muestra color + info overlay
 */
import type { Project } from '../../lib/types';

interface Props extends Project {}

const { name, image, url, size } = Astro.props;

// Aspect ratios según el tamaño en el grid
// Con grid-cols-[2fr_1fr_1fr]:
// - wide (2fr): aspect-[2/1] para que altura = 1fr
// - normal (1fr): aspect-square para que altura = 1fr
// Así todos tienen la misma altura
const aspectClasses = {
  normal: 'aspect-square',
  tall: 'aspect-square',
  wide: 'aspect-square md:aspect-[2/1]',
};
---

<article class:list={[
  "project-card group relative overflow-hidden rounded-lg cursor-pointer",
  aspectClasses[size]
]}>
  <!-- Imagen con filtro grayscale -->
  <img
    src={image}
    alt={`Proyecto ${name}`}
    class="w-full h-full object-cover transition-all duration-500 grayscale group-hover:grayscale-0"
    loading="lazy"
  />

  <!-- Overlay con gradiente (aparece en hover) -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

  <!-- Info container (aparece desde abajo en hover) -->
  <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out">
    <div class="flex items-end justify-between">
      <h4 class="font-title text-xl md:text-2xl text-(--color-white)">
        {name}
      </h4>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-(--color-white)/10 text-(--color-white) hover:bg-(--color-accent) hover:text-(--color-white) transition-colors"
        aria-label={`Ver proyecto ${name}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</article>
