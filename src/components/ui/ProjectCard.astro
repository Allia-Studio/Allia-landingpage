---
/**
 * ProjectCard.astro - Card para proyectos del portfolio
 * Imagen, título, descripción, tecnologías
 */
import type { ProjectItem } from '../../lib/types';
import Tag from './Tag.astro';

interface Props {
  project: ProjectItem;
  class?: string;
}

const { project, class: className = '' } = Astro.props;

// Placeholder image when no image available
const imageSrc = project.image || '/images/placeholder-project.jpg';
---

<article
  class:list={[
    'group relative overflow-hidden rounded-[--radius-lg] bg-[--color-surface] border border-[--color-border]',
    'transition-all duration-300 ease-out',
    'hover:border-[--color-accent] hover:-translate-y-1',
    className,
  ]}
  data-category={project.category}
>
  <!-- Image Container -->
  <div class="relative aspect-[16/10] overflow-hidden bg-[--color-bg-dark]">
    <div class="absolute inset-0 bg-gradient-to-t from-[--color-surface] via-transparent to-transparent z-10" />
    <!-- Placeholder gradient when no image -->
    <div class="absolute inset-0 bg-gradient-to-br from-[--color-accent]/20 to-[--color-bg-dark]" />
  </div>

  <!-- Content -->
  <div class="p-6">
    <h3 class="font-title text-2xl uppercase mb-2 group-hover:text-[--color-accent] transition-colors">
      {project.title}
    </h3>

    <p class="text-[--color-gray] text-sm leading-relaxed mb-4">
      {project.description}
    </p>

    {project.technologies && project.technologies.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {project.technologies.map((tech) => (
          <Tag label={tech} variant="solid" size="sm" />
        ))}
      </div>
    )}
  </div>
</article>
