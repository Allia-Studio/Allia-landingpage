---
/**
 * MotorCard.astro - Card para la sección Proceso/Motores
 * Letra grande (A/B), porcentaje, bullets
 */
import type { MotorItem } from '../../lib/types';
import IconCheck from '../icons/IconCheck.astro';

interface Props {
  motor: MotorItem;
  class?: string;
}

const { motor, class: className = '' } = Astro.props;
---

<article
  class:list={[
    'relative p-10 rounded-[--radius-lg] bg-[--color-surface] border border-[--color-border]',
    'transition-all duration-300 ease-out',
    'hover:border-[--color-accent]',
    className,
  ]}
>
  <!-- Motor Letter Badge -->
  <div class="absolute -top-8 -left-4">
    <span class="font-display text-8xl text-[--color-accent] opacity-80">
      {motor.id}
    </span>
  </div>

  <div class="pt-10">
    <!-- Header -->
    <div class="flex items-start justify-between mb-4">
      <h3 class="font-title text-3xl uppercase">
        {motor.title}
      </h3>
      <span class="text-4xl font-display text-[--color-accent]">
        {motor.percentage}
      </span>
    </div>

    <!-- Description -->
    <p class="text-[--color-gray] leading-relaxed mb-6">
      {motor.description}
    </p>

    <!-- Bullets -->
    <ul class="space-y-3">
      {motor.bullets.map((bullet) => (
        <li class="flex items-start gap-3">
          <IconCheck size={20} class="text-[--color-accent] mt-0.5 flex-shrink-0" />
          <span class="text-[--color-white]">{bullet}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
