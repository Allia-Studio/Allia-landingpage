---
/**
 * Tag.astro - Pills/tags de tecnología
 * Variantes: outline, solid, ghost
 */
import type { TagProps } from '../../lib/types';

interface Props extends TagProps {}

const {
  label,
  variant = 'outline',
  size = 'sm',
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'px-3 py-1 text-xs',
  md: 'px-4 py-1.5 text-sm',
};

const variantClasses = {
  outline: 'border border-[--color-border] text-[--color-gray] hover:border-[--color-accent] hover:text-[--color-accent]',
  solid: 'bg-[--color-surface-elevated] text-[--color-white]',
  ghost: 'text-[--color-gray] hover:text-[--color-white]',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full font-medium transition-colors',
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
>
  {label}
</span>
