---
/**
 * ServiceRow.astro - Fila de servicio con alineación global
 * Layout con CSS Grid para alineación consistente entre filas
 */
import type { TechItem, ServiceIcon } from '../../lib/types';

interface Props {
  id: string;
  title: string;
  description: string;
  icon: ServiceIcon;
  technologies: readonly TechItem[];
}

const { id, title, description, icon, technologies } = Astro.props;

const iconPaths: Record<ServiceIcon, string> = {
  globe: 'M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm6.918 6h-3.215a14.078 14.078 0 0 0-1.237-3.592A8.028 8.028 0 0 1 18.918 8zM12 4.068c.756 1.05 1.348 2.238 1.753 3.532h-3.506A11.95 11.95 0 0 1 12 4.068zM4.262 14a7.895 7.895 0 0 1 0-4h3.476a15.357 15.357 0 0 0 0 4H4.262zm.82 2h3.215a14.078 14.078 0 0 0 1.237 3.592A8.028 8.028 0 0 1 5.082 16zm3.215-8H5.082a8.028 8.028 0 0 1 4.452-3.592A14.078 14.078 0 0 0 8.297 8zM12 19.932a11.95 11.95 0 0 1-1.753-3.532h3.506A11.95 11.95 0 0 1 12 19.932zM14.178 14H9.822a13.36 13.36 0 0 1 0-4h4.356a13.36 13.36 0 0 1 0 4zm.356 5.592A14.078 14.078 0 0 0 15.77 16h3.215a8.028 8.028 0 0 1-4.452 3.592zM16.262 14a15.357 15.357 0 0 0 0-4h3.476a7.895 7.895 0 0 1 0 4h-3.476z',
  mobile: 'M7 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H7zm0 2h10v16H7V4zm5 14a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  desktop: 'M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6v2h2v2H8v-2h2v-2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v10h16V6H4z',
  brain: 'M12 2a9 9 0 0 0-9 9c0 3.074 1.676 5.925 4.5 7.459V22h9v-3.541A8.963 8.963 0 0 0 21 11a9 9 0 0 0-9-9zm0 2a7 7 0 0 1 7 7c0 2.38-1.235 4.584-3.272 5.873l-.728.46V20h-6v-2.667l-.728-.46A6.963 6.963 0 0 1 5 11a7 7 0 0 1 7-7zm-2 7a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm4 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  zap: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
};
---

<article
  id={id}
  class="grid grid-cols-1 lg:grid-cols-[auto_1fr_minmax(280px,auto)] items-center py-12 md:py-14 border-b border-(--color-gray-light) gap-6 lg:gap-10"
>
  <svg
    class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 text-(--color-accent) flex-shrink-0"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={iconPaths[icon]} />
  </svg>

  <div class="lg:max-w-sm">
    <h3 class="font-title text-2xl md:text-3xl text-(--color-bg) mb-1">
      {title}
    </h3>
    <p class="text-base md:text-lg text-(--color-gray-dark)">
      {description}
    </p>
  </div>

  <div class="grid grid-cols-2 gap-x-10 gap-y-1.5 text-sm md:text-base text-(--color-gray-dark)">
    {technologies.map((tech) => (
      <span class="whitespace-nowrap">{tech.name}</span>
    ))}
  </div>
</article>
