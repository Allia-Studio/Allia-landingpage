---
import type { ContainerProps } from '../../lib/types';

interface Props extends ContainerProps {}

const {
  class: className,
  as: Tag = 'div'
} = Astro.props;

const classes = `w-full max-w-[var(--container-max-width)] mx-auto ${className || ''}`.trim();
---

<Tag class={classes}>
  <slot />
</Tag>
