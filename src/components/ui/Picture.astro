---
/**
 * Picture.astro - Componente para imágenes optimizadas con WebP fallback
 * Genera automáticamente source WebP basado en el path de la imagen
 */
interface Props {
  /** Path de la imagen (ej: "/logo.png") */
  src: string;
  alt: string;
  class?: string;
  imgClass?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  class: className = '',
  imgClass = '',
  width,
  height,
  loading = 'eager'
} = Astro.props;

// Derivar path webp del src
const basePath = src.replace(/\.(png|jpg|jpeg)$/i, '');
const webpSrc = `${basePath}.webp`;
---

<picture class={className}>
  <source srcset={webpSrc} type="image/webp" />
  <img
    src={src}
    alt={alt}
    class={imgClass}
    width={width}
    height={height}
    loading={loading}
  />
</picture>
