---
/**
 * FooterColumn.astro - Columna de links del footer
 */
import type { FooterColumn } from '../../lib/types';

interface Props {
  column: FooterColumn;
  class?: string;
}

const { column, class: className = '' } = Astro.props;
---

<div class:list={['space-y-4', className]}>
  <h4 class="font-title text-lg uppercase text-[--color-white]">
    {column.title}
  </h4>

  <ul class="space-y-3">
    {column.links.map((link) => (
      <li>
        <a
          href={link.href}
          class="text-[--color-gray] hover:text-[--color-accent] transition-colors text-sm"
          {...(link.isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>
