---
import type { ButtonProps } from '../../lib/types';

interface Props extends ButtonProps {}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-display font-normal uppercase tracking-wide rounded-[--radius-pill] cursor-pointer relative overflow-hidden';

const sizeClasses = {
  sm: 'px-5 py-3 text-base',
  md: 'px-7 py-4 text-xl',
  lg: 'px-9 py-5 text-2xl'
};

const variantClasses = {
  primary: 'border-2 border-white btn-primary',
  secondary: 'bg-transparent border-2 border-white text-white btn-secondary',
  ghost: 'bg-transparent text-white hover:text-[--color-accent]'
};

const classes = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className || ''}`.trim();
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <span class="btn-text relative z-10"><slot /></span>
    <span class="btn-bg"></span>
  </a>
) : (
  <button class={classes} {...rest}>
    <span class="btn-text relative z-10"><slot /></span>
    <span class="btn-bg"></span>
  </button>
)}

<style>
  /* Primary variant - white bg with orange slide on hover */
  .btn-primary {
    color: var(--color-bg);
    background: transparent;
  }

  .btn-primary .btn-bg {
    position: absolute;
    inset: 0;
    background-color: var(--color-white);
    transition: transform 0.4s var(--ease-out-expo);
    z-index: 0;
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform: translateX(-100%);
    transition: transform 0.4s var(--ease-out-expo);
    z-index: 1;
  }

  .btn-primary:hover {
    color: var(--color-white);
    border-color: var(--color-accent);
  }

  .btn-primary:hover::before {
    transform: translateX(0);
  }

  .btn-primary .btn-text {
    z-index: 2;
  }

  /* Secondary variant - transparent with white border */
  .btn-secondary {
    transition:
      background-color var(--transition-normal),
      color var(--transition-normal);
  }

  .btn-secondary:hover {
    background-color: var(--color-white);
    color: var(--color-bg);
  }

  .btn-secondary .btn-bg {
    display: none;
  }

  /* Focus states for accessibility */
  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .btn-primary:focus-visible {
    border-color: var(--color-accent);
  }
</style>
