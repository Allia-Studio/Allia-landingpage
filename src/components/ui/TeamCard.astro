---
/**
 * TeamCard.astro - Tarjeta de miembro del equipo
 * Foto en escala de grises, al hover muestra color + info overlay
 * Touch devices: tap-to-reveal behavior (via shared script)
 */
import type { TeamMember } from '../../lib/types';

interface Props extends TeamMember {}

const { name, role, linkedin, photo } = Astro.props;
---

<article class="team-card group relative aspect-[3/4] overflow-hidden rounded-lg cursor-pointer" data-card-reveal>
  <!-- Imagen con filtro grayscale -->
  <img
    src={photo}
    alt={`Foto de ${name}`}
    class="w-full h-full object-cover transition-all duration-500 grayscale group-hover:grayscale-0 group-[.active]:grayscale-0"
    loading="lazy"
  />

  <!-- Overlay con gradiente -->
  <div class="card-overlay absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity duration-500" />

  <!-- Info container (aparece desde abajo) -->
  <div class="card-info absolute bottom-0 left-0 right-0 p-6 translate-y-full group-hover:translate-y-0 group-[.active]:translate-y-0 transition-transform duration-500 ease-out">
    <div class="flex items-end justify-between">
      <div>
        <h4 class="font-title text-xl md:text-2xl text-(--color-white) mb-1">
          {name}
        </h4>
        <p class="text-sm md:text-base text-(--color-gray-light)">
          {role}
        </p>
      </div>
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="card-action flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-(--color-white)/10 text-(--color-white) hover:bg-(--color-accent) hover:text-(--color-white) transition-colors"
        aria-label={`LinkedIn de ${name}`}
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </div>
</article>
