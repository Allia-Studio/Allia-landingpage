---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ServiciosSection from '../components/sections/ServiciosSection.astro';
import ProcesoSection from '../components/sections/ProcesoSection.astro';
import ProyectosSection from '../components/sections/ProyectosSection.astro';
