---
import '../styles/global.css';
import { SITE } from '../lib/constants';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Allia Studio',
	description = SITE.description,
	image = '/logo-white.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const imageURL = new URL(image, SITE.url);
---

<!doctype html>
<html lang="es" dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:site_name" content={SITE.name} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<!-- Preconexión a Google Fonts para carga más rápida -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Google Fonts -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Changa+One&family=Rowdies:wght@300;400;700&family=Inter:wght@400;500;600;700&display=swap"
		/>

		<!-- Color del tema para navegadores móviles -->
		<meta name="theme-color" content={SITE.themeColor} />

		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<!-- Link para saltar al contenido (accesibilidad) -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:rounded"
		>
			Saltar al contenido principal
		</a>

		<slot />

		<!-- Código embed de Cal.com (carga lazy en interacción del usuario) -->
		<script>
			let calLoaded = false;

			function loadCalcom() {
				if (calLoaded) return;
				calLoaded = true;

				(function (C, A, L) {
					let p = function (a, ar) {
						a.q.push(ar);
					};
					let d = C.document;
					C.Cal =
						C.Cal ||
						function () {
							let cal = C.Cal;
							let ar = arguments;
							if (!cal.loaded) {
								cal.ns = {};
								cal.q = cal.q || [];
								d.head.appendChild(d.createElement("script")).src = A;
								cal.loaded = true;
							}
							if (ar[0] === L) {
								const api = function () {
									p(api, arguments);
								};
								const namespace = ar[1];
								api.q = api.q || [];
								if (typeof namespace === "string") {
									cal.ns[namespace] = cal.ns[namespace] || api;
									p(cal.ns[namespace], ar);
									p(cal, ["initNamespace", namespace]);
								} else p(cal, ar);
								return;
							}
							p(cal, ar);
						};
				})(window, "https://app.cal.com/embed/embed.js", "init");

				Cal("init", "30min", { origin: "https://app.cal.com" });

				Cal.ns["30min"]("ui", {
					cssVarsPerTheme: { dark: { "cal-brand": "#ffd43b" } },
					hideEventTypeDetails: false,
					layout: "column_view",
				});
			}

			// Carga lazy de Cal.com en interacción con el botón CTA
			document.addEventListener('DOMContentLoaded', () => {
				const ctaButton = document.querySelector('[data-cal-link]');
				if (ctaButton) {
					// Carga en hover (desktop)
					ctaButton.addEventListener('mouseenter', loadCalcom, { once: true });
					// Carga en focus (navegación por teclado)
					ctaButton.addEventListener('focus', loadCalcom, { once: true });
					// Carga en touch start (móvil)
					ctaButton.addEventListener('touchstart', loadCalcom, { once: true, passive: true });
				}

				// También precarga después de que la página esté idle (fallback)
				if ('requestIdleCallback' in window) {
					requestIdleCallback(loadCalcom, { timeout: 3000 });
				} else {
					setTimeout(loadCalcom, 2000);
				}
			});
		</script>
	</body>
</html>
