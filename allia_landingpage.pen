                              "name": "faq3QText",
                              "fill": "#272822",
                              "content": "¿Qué es el programa de financiamiento?",
                              "fontFamily": "Rowdies",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "E8FM3",
                              "name": "faq3Icon",
                              "fill": "#f18661",
                              "content": "+",
                              "fontFamily": "Inter",
                              "fontSize": 24,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "JShNW",
                          "name": "faq3A",
                          "fill": "#555555",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Para startups con validación real (cartas de intención, preventas, contratos) pero sin liquidez. Ofrecemos enganche menor (10-30%), período de gracia (2-6 meses) y cuotas mensuales. Retenemos propiedad del código hasta pago completo.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
