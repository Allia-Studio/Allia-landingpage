                            {
                              "type": "text",
                              "id": "ET3cs",
                              "name": "faq2QText",
                              "fill": "#272822",
                              "content": "¿Trabajan gratis o por equity?",
                              "fontFamily": "Rowdies",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "aqsPD",
                              "name": "faq2Icon",
                              "fill": "#f18661",
                              "content": "+",
                              "fontFamily": "Inter",
                              "fontSize": 24,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "sksH3",
                          "name": "faq2A",
                          "fill": "#555555",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "No. Cobramos precio de mercado completo siempre. No somos un venture studio, fondo de inversión ni aceleradora. Nuestra contribución es capacidad técnica de ejecución, no dinero. Somos inversores de código, no de capital.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "OIQv0",
                      "name": "FAQ 3",
                      "width": "fill_container",
